# Copy to `.dev.vars` and fill in. Same KEY=VALUE format wrangler uses.
# Used by both `wrangler dev` and the local backup runner (src/local.ts).
# `.dev.vars` is gitignored — never commit real secrets.

# Account mnemonic for signing registration transactions (required to register).
MNEMONIC="word1 word2 word3 ... word25"

# Optional sender address override, for rekeyed accounts. Leave unset otherwise.
# SENDER=REGISTRY2UJANM5G2G45MZD4DKPH7RPBDJRJ3HSFDPO4IY7HKU5ZY4MLV4

# Optional indexer API token, sent as the X-Indexer-API-Token header (the
# default Algorand indexer header, e.g. a Nodely paid-tier key). Leave unset
# to use the free/public indexer endpoints.
# In the Worker, set this as a secret instead: `wrangler secret put INDEXER_TOKEN`.
# INDEXER_TOKEN=your-indexer-api-token

# Escreg app to register into and the algod of its network. Unset = the SDK's
# default deployment. The Worker pins these in wrangler.jsonc.
# APP_ID=773212345
# ALGOD_SERVER=https://testnet-api.4160.nodely.dev

# Optional algod API token for ALGOD_SERVER, sent as X-Algo-API-Token (ignored
# without ALGOD_SERVER). In the Worker: `wrangler secret put ALGOD_TOKEN`.
# ALGOD_TOKEN=your-algod-api-token

# --- Local backup runner only (ignored by wrangler) ---

# Cursor file path. Default: ./.local-state/cursors.json
# STATE_FILE=/var/lib/escreg/cursors.json

# Poll interval in ms for `npm run local`. Default: 60000
# INTERVAL_MS=60000
